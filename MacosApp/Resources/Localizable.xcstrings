    "about_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorta helps organize photographs, convert images to HEIC, and correct file dates. Start with a small set of copies and check the results before processing your entire archive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorta помогает упорядочивать фотографии, конвертировать изображения в HEIC и исправлять даты файлов. Начните с небольшого набора копий и проверьте результат перед обработкой всего архива."
          }
        }
      }
    },
