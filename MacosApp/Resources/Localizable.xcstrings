    },
    "important_information_paragraph_one" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographs are the most important things we have: they preserve the people we love, precious memories, and moments that can never be repeated. Treat your photo archive with care: lost photographs cannot always be recovered."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотографии — самое важное, что есть у человека: в них остаются близкие люди, дорогие воспоминания и моменты, которые невозможно повторить. Относитесь к своему фотоархиву бережно: потерянные снимки не всегда можно восстановить."
          }
        }
      }
    },
    "important_information_paragraph_two" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before processing your entire photo collection, first try a small set of file copies and leave “Delete after processing” turned off. Check the results carefully: open the photographs, make sure they were processed as expected, and verify that the original files are still there. Only when you are completely satisfied with the results should you process all your photos, keeping a backup of the originals."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем массово обрабатывать все фотографии, сначала попробуйте обработать небольшой набор копий файлов и не включайте пункт «Удалить после обработки». Внимательно проверьте результат: откройте фотографии, убедитесь, что всё обработано так, как вы ожидали, а исходные файлы сохранились. Только и только тогда, когда результат вас полностью устроит, переходите к обработке всех фото, сохранив резервную копию оригиналов."
          }
        }
      }
    },
    "important_information_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
